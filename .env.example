# Copy to .env and fill in. .env is gitignored, so never commit real keys.

# ElevenLabs: Scribe speech-to-text + narration voice (needed from M1)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Voice used for the summary video narration (from the ElevenLabs voice library)
ELEVENLABS_VOICE_ID=your-voice-id

# Anthropic API: used ONLY by the Haiku frame reader (needed from M3).
# Opus runs through headless Claude Code on the Claude plan, and this key is stripped from its environment.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Hosted demo (M8): comma-separated access codes that allow uploads
ENGRAM_ACCESS_CODES=change-me

# Cloudflare R2: where big files live (uploads, web copies, summary videos), so the
# server disk never fills up. Leave the placeholders and Engram keeps everything on disk.
# Create an R2 API token with "Object Read & Write" on this bucket (R2 → Manage API tokens).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
